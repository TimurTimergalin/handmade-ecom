# Copy to .env before `make up`. Values below are dev defaults and are not secrets.

# --- Infrastructure ---
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=masterKeyForLocalDevOnly

GORSE_URL=http://gorse:8088
GORSE_API_KEY=gorseApiKeyForLocalDevOnly

# --- Shared app settings ---
LOG_LEVEL=INFO
LOG_JSON=true
ENVIRONMENT=local

# Frontend contract (Next.js)
B2C_CORS_ORIGIN=http://localhost:3000
AUTH_COOKIE_SECURE=false
B2C_PAYMENT_STUB_URL=https://yoomoney.ru/checkout/demo

# --- B2C BFF upstream URLs ---
B2C_USERS_URL=http://users:8000
B2C_PUBLICATIONS_URL=http://publications:8000
B2C_CART_URL=http://cart:8000
B2C_ORDERS_URL=http://orders:8000
B2C_GOODS_URL=http://goods:8000
B2C_SEARCH_URL=http://search:8000
B2C_EVENTER_URL=http://eventer:8000
B2C_GORSE_URL=http://gorse:8088
B2C_UPSTREAM_TIMEOUT_SECONDS=2.0
B2C_UPSTREAM_RETRIES=2

AUTH_DEV_MODE=true
AUTH_JWT_SECRET=changeme

# B2B read-model hydration (goods and publications consumers, users compat API)
SERVICE_KEY=
B2B_URL=http://b2b:8000/api
B2B_GOODS_URL=http://b2b-goods:8000/api
B2B_PUBLICATIONS_URL=http://b2b-publications:8000/api
USERS_URL=http://users:8000
KAFKA_PRODUCTS_TOPIC=handmade.products.v1
KAFKA_PUBLICATIONS_TOPIC=handmade.publications.v1
KAFKA_ENABLED=true
